# Client (Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key
VITE_SITE_URL=https://pahraan.com

# Optional analytics (overridden by Admin → Tracking IDs)
VITE_GA4_ID=
VITE_GTM_ID=
VITE_GSC_VERIFICATION=
VITE_META_PIXEL_ID=
VITE_PINTEREST_TAG=
VITE_TIKTOK_PIXEL=
VITE_CLARITY_ID=

# Server / SSR
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key
SITE_URL=https://pahraan.com
FORCE_HTTPS=true
NODE_ENV=production

# Server-only admin client (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
